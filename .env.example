# Copy to .env.local and fill in. See README.md, "Environment variables".

# From `npm run db:status` (local) or Supabase dashboard > Project Settings > API (production).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# The public "anon" (or "publishable") key. Safe to expose to browsers: RLS protects the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=paste-anon-key-here

# Public address of the site, used in email links. No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# NEVER set a service-role / secret key here. The app does not use one.
